import * as React from "react";
import { Link, LinkProps, useLocation } from "react-router-dom";

type Props = LinkProps & {
  /** If true, scroll to top when link points to current pathname with no hash. */
  forceTop?: boolean;
  /** Retry attempts for same-page hash scrolling (DOM may not be ready). */
  hashTries?: number;
};

export function ScrollLink({
  forceTop = true,
  hashTries = 20,
  onClick,
  to,
  ...rest
}: Props) {
  const location = useLocation();

  const handleClick = (e: React.MouseEvent<HTMLAnchorElement>) => {
    onClick?.(e);
    if (e.defaultPrevented) return;

    if (typeof to !== "string") return;

    const [targetPath, hashPart] = to.split("#");
    const currentPath = location.pathname;
    const hasHash = Boolean(hashPart);

    // ✅ Same page + hash => scroll to element here (in-place)
    if (targetPath === currentPath && hasHash) {
      const id = decodeURIComponent(hashPart || "").trim();
      if (!id) return;

      e.preventDefault(); // prevent redundant navigation

      let tries = 0;
      const tryFind = () => {
        const el = document.getElementById(id);
        if (el) {
          el.scrollIntoView({ behavior: "smooth", block: "start" });
          return;
        }
        tries += 1;
        if (tries < hashTries) window.setTimeout(tryFind, 50);
      };

      requestAnimationFrame(tryFind);
      return;
    }

    // ✅ Same page without hash => scroll to top
    if (forceTop && targetPath === currentPath && !hasHash) {
      requestAnimationFrame(() => {
        window.scrollTo({ top: 0, left: 0, behavior: "smooth" });
      });
    }
  };

  return <Link to={to} onClick={handleClick} {...rest} />;
}